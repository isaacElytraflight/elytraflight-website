    {
      "id": "nl-cap-r1-q3",
      "round": 1,
      "type": "numeric",
      "prompt": "A device has \\(Q(V)=KV^2\\) with \\(K=2\\ \\mathrm{pC/V^2}\\). What is its small-signal capacitance at \\(V=1.5\\ \\mathrm{V}\\), in pF?",
