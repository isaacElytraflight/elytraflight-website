    {
      "id": "nl-cap-r3-q2",
      "round": 3,
      "type": "numeric",
      "prompt": "Compute the EXACT charge change of the junction (\\(Q_0=2\\ \\mathrm{pC}\\), \\(\\phi_b=0.8\\ \\mathrm{V}\\)) when \\(V\\) goes from \\(-2\\ \\mathrm{V}\\) to \\(-1\\ \\mathrm{V}\\), in pC.",
      "answer": 0.741657,
      "unit": "pC",
      "tolerance": 0.02,
      "explanation": "\\(\\Delta Q=Q_j(-1)-Q_j(-2)=-2\\left[\\sqrt{1+1.25}-\\sqrt{1+2.5}\\right]=-2[1.5-1.871]=0.7417\\ \\mathrm{pC}\\).\nThe small-signal estimate \\(C(-2)\\times1\\ \\mathrm{V}=0.668\\ \\mathrm{pC}\\) is about 10% low, because \\(C\\) grows as the bias approaches \\(\\phi_b\\).",
      "figure": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 330 140\" role=\"img\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" font-family=\"sans-serif\" font-size=\"12\"><title>Q_j(V) of a junction</title><line x1=\"30\" y1=\"20\" x2=\"310\" y2=\"20\" stroke-opacity=\"0.5\"/><text x=\"310\" y=\"34\" text-anchor=\"end\" font-size=\"10\" fill=\"currentColor\" stroke=\"none\">V</text><polyline points=\"30,120 34.7,119.2 39.3,118.4 44,117.6 48.7,116.8 53.3,115.9 58,115.1 62.7,114.2 67.3,113.4 72,112.5 76.7,111.7 81.3,110.8 86,109.9 90.7,109 95.3,108.1 100,107.2 104.7,106.3 109.3,105.4 114,104.4 118.7,103.5 123.3,102.5 128,101.5 132.7,100.5 137.3,99.5 142,98.5 146.7,97.5 151.3,96.5 156,95.4 160.7,94.3 165.3,93.3 170,92.2 174.7,91.1 179.3,89.9 184,88.8 188.7,87.6 193.3,86.4 198,85.2 202.7,84 207.3,82.7 212,81.4 216.7,80.1 221.3,78.7 226,77.4 230.7,76 235.3,74.5 240,73 244.7,71.5 249.3,69.9 254,68.3 258.7,66.6 263.3,64.9 268,63.1 272.7,61.2 277.3,59.2 282,57.1 286.7,54.9 291.3,52.5 296,49.9 300.7,47.1 305.3,44 310,40.4\" stroke-width=\"2.2\"/><text x=\"34\" y=\"14\" text-anchor=\"start\" font-size=\"11\" fill=\"currentColor\" stroke=\"none\">Q</text></svg>",
