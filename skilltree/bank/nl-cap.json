    {
      "id": "nl-cap-r2-q3",
      "round": 2,
      "type": "mc",
      "prompt": "For the same junction at \\(V=-2\\ \\mathrm{V}\\), which value is the small-signal capacitance?",
      "options": [
        "1.87 pF, the ratio \\(Q/V\\)",
