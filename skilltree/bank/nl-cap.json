    {
      "id": "nl-cap-r3-q3",
      "round": 3,
      "type": "mc",
      "prompt": "For \\(C_j(V)=\\dfrac{C_{j0}}{\\sqrt{1-V/\\phi_b}}\\), what happens to the capacitance as the reverse bias increases (\\(V\\) more negative)?",
      "options": [
        "It decreases, slowly (as \\(1/\\sqrt{\\phi_b-V}\\))",
        "It increases",
        "It stays at \\(C_{j0}\\)",
        "It drops linearly to zero at \\(V=-\\phi_b\\)"
      ],
