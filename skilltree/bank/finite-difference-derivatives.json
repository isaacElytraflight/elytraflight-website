    {
      "id": "finite-difference-derivatives-r3-q1",
      "round": 3,
      "type": "numeric",
      "prompt": "Let \\(f(t) = t^3\\). At \\(t = 2\\) with step \\(h = 0.1\\), what is the absolute error of the forward difference against the exact derivative?",
