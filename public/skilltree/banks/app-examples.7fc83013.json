2\\). The reciprocal \\(\\ell/g\\) is a time squared.","figure":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 300 180\" role=\"img\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" font-family=\"sans-serif\" font-size=\"12\"><title>pendulum poles</title><line x1=\"20\" y1=\"90\" x2=\"280\" y2=\"90\"/><polygon points=\"280,90 273.6,92.7 273.6,87.3\" fill=\"currentColor\" stroke=\"none\"/><line x1=\"150\" y1=\"160\" x2=\"150\" y2=\"16\"/><polygon points=\"150,16 152.7,22.4 147.3,22.4\" fill=\"currentColor\" stroke=\"none\"/><text x=\"274\" y=\"106\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" stroke=\"none\">Re</text><text x=\"158\" y=\"14\" text-anchor=\"start\" font-size=\"11\" fill=\"currentColor\" stroke=\"none\">Im</text><line x1=\"145\" y1=\"16.1\" x2=\"155\" y2=\"26.1\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"26.1\" x2=\"155\" y2=\"16.1\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"153.9\" x2=\"155\" y2=\"163.9\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"163.9\" x2=\"155\" y2=\"153.9\" stroke-width=\"1.8\"/></svg>","figure_alt":"Two pole marks on the imaginary axis."},{"id":"app-examples-r3-q2","version":1,"round":3,"type":"numeric","prompt":"A pendulum has length \\(\\ell = 1\\) m and \\(g = 10\\) m/s\\(^2\\). The natural frequency is","answer":3.16228,"unit":"rad/s","tolerance":0.02,"explanation":"\\(\\omega_n = \\sqrt{g/\\ell} = \\sqrt{10} = 3.16\\) rad/s. The length 1 is not the frequency. The gravity 10 is \\(\\omega_n^2\\), not \\(\\omega_n\\).","figure":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 300 180\" role=\"img\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" font-family=\"sans-serif\" font-size=\"12\"><title>pendulum poles</title><line x1=\"20\" y1=\"90\" x2=\"280\" y2=\"90\"/><polygon points=\"280,90 273.6,92.7 273.6,87.3\" fill=\"currentColor\" stroke=\"none\"/><line x1=\"150\" y1=\"160\" x2=\"150\" y2=\"16\"/><polygon points=\"150,16 152.7,22.4 147.3,22.4\" fill=\"currentColor\" stroke=\"none\"/><text x=\"274\" y=\"106\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" stroke=\"none\">Re</text><text x=\"158\" y=\"14\" text-anchor=\"start\" font-size=\"11\" fill=\"currentColor\" stroke=\"none\">Im</text><line x1=\"145\" y1=\"15.4\" x2=\"155\" y2=\"25.4\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"25.4\" x2=\"155\" y2=\"15.4\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"154.6\" x2=\"155\" y2=\"164.6\" stroke-width=\"1.8\"/><line x1=\"145\" y1=\"164.6\" x2=\"155\" y2=\"154.6\" stroke-width=\"1.8\"/></svg>","figure_alt":"Two pole marks on the imaginary axis."},{"id":"app-examples-r3-q3","version":1,"round":3,"type":"numeric","prompt":"A tank's level decays with time constant 5 s. Starting at \\(h = 3\\) m with no inflow, the level at \\(t = 5\\) s is","answer":1.10364,"unit":"m","tolerance":0.02,"explanation":"At one time constant, \\(h = 3 e^{-1} = 1.10\\) m. The initial level 3 is not the answer. Half of 3 is 1.5, which is not \\(e^{-1}\\) of 3.","figure":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 340 176\" role=\"img\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" font-family=\"sans-serif\" font-size=\"12\"><title>tank decay</title><line x1=\"46\" y1=\"146\" x2=\"318\" y2=\"146\"/><polygon points=\"318,146 311.6,148.7 311.6,143.3\" fill=\"currentColor\" stroke=\"none\"/><line x1=\"46\" y1=\"146\" x2=\"46\" y2=\"24\"/><polygon points=\"46,24 48.7,30.4 43.3,30.4\" fill=\"currentColor\" stroke=\"none\"/><text x=\"318\" y=\"162\" text-anchor=\"end\" fill=\"currentColor\" stroke=\"none\">t</text><text x=\"50\" y=\"20\" text-anchor=\"start\" fill=\"currentColor\" stroke=\"none\">y</text><polyline points=\"46,39 49,42.3 52,45.4 55.1,48.4 58.1,51.3 61.1,54.2 64.1,56.9 67.2,59.6 70.2,62.1 73.2,64.6 76.2,67 79.2,69.3 82.3,71.6 85.3,73.7 88.3,75.8 91.3,77.9